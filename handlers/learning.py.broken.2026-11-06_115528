@router.callback_query(F.data.startswith("level_"))
async def cb_set_level(callback: CallbackQuery, db: Database):
    await callback.answer()
    new_level = callback.data.split("_")[1]
    await db.set_level(callback.from_user.id, new_level)
    await callback.message.edit_text(f"✅ Уровень изменен на: <b>{new_level.capitalize()}</b>", reply_markup=get_main_menu_keyboard(), parse_mode="HTML")
