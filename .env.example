# --- Обязательное ---
BOT_TOKEN=123456:ABC...            # токен от @BotFather

# ============================================================
# СВЯЗКА «из РФ, почти бесплатно, офлайн-устойчивая» (LXC без Docker):
#   LLM:  Groq (0 ₽) → при исчерпании лимитов Ollama qwen2.5:7b локально (0 ₽)
#         → если и он недоступен — встроенный офлайн rule-based движок
#   STT:  faster-whisper base (~150 MB) — качается install-bot.sh при установке
#   TTS:  Piper en_US-lessac-medium (~60 MB, без Yandex) — тоже качается сам
# Все модели в /opt/english-bot/models_cache и /opt/english-bot/ollama_models.
# ============================================================

# --- LLM для диалога ---
# Основной провайдер: Groq — бесплатный API-ключ (console.groq.com), работает из РФ
GROQ_API_KEY=
# Резервный провайдер: локальная Ollama (устанавливается install-bot.sh автоматически).
# Выключить резерв: OLLAMA_ENABLED=off (экономит ~5 GB диска и RAM).
OLLAMA_ENABLED=on
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# Кулдаун провайдера при лимитах (сек), по умолчанию 900 = 15 мин:
# LLM_COOLDOWN_SEC=900
# Альтернатива вместо Groq — любой OpenAI-совместимый сервис из РФ
# (Selectel Select AI, Cloud.ru): заполните OPENAI_API_KEY/OPENAI_MODEL
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Голос: распознавание голосовых сообщений (STT) ---
# Вариант A (0 ₽, по умолчанию): локальный faster-whisper (base; на слабом CPU — tiny)
WHISPER_LOCAL_MODEL=base
# Вариант B (при росте, ~$0.006/мин): OpenAI-совместимый Whisper API из РФ
# (Selectel Select AI / Cloud.ru) — код сам предпочтёт API, если заполнено:
SPEECH_API_KEY=
SPEECH_BASE_URL=
WHISPER_MODEL=whisper-1

# --- Голос: озвучка ответов бота (TTS) ---
# По умолчанию (0 ₽, офлайн, БЕЗ Yandex): локальный Piper. Путь к голосу
# прописывает install-bot.sh после скачивания модели:
PIPER_MODEL_PATH=
# Опционально (нужен аккаунт Yandex Cloud, тест-период ~2000 симв./сутки):
YANDEX_SPEECHKIT_API_KEY=
YANDEX_SPEECHKIT_FOLDER_ID=
YANDEX_TTS_VOICE=albina
# off | on | toggle — озвучивать ли ответы по умолчанию
VOICE_REPLY_ENABLED=off

# --- База данных ---
DB_PATH=english_bot.db

# --- Монетизация: Telegram Stars и тарифы ---
# Цены в звёздах за 30 дней (должны быть кратны 10):
PREMIUM_STARS=250
PLUS_STARS=120
PREMIUM_DAYS=30
PLUS_DAYS=30
# Лимиты бесплатного плана:
FREE_WORDS_PER_DAY=5
FREE_QUIZZES_PER_DAY=3
FREE_CHAT_MESSAGES_PER_DAY=15
OPEN_TOPICS_FREE=4
# Лимиты голоса на Plus (в день):
PLUS_VOICE_INPUTS_PER_DAY=15
PLUS_VOICE_REPLIES_PER_DAY=10
# Авто-повторения слов (бот сам присылает слова, Plus/Premium):
AUTO_REVIEWS_ENABLED=on
AUTO_REVIEW_INTERVAL=1800
